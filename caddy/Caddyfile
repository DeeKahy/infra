# Apache handles TLS and proxies these hostnames to 127.0.0.1:8080.
# Caddy only speaks plain HTTP on localhost until it takes over 80/443.
{
	auto_https off
	http_port {$CADDY_PORT:8080}
	default_bind 127.0.0.1
	servers {
		# Apache is in front, so believe what it says about the visitor.
		trusted_proxies static 127.0.0.1/32 ::1
	}
}

(static) {
	root * {args[0]}
	file_server {
		hide .git .gitignore .idea
	}
	log
}

# The wiki. The bare http:// also catches unknown hostnames, as Apache's default vhost did.
http://fklub.dk, http://www.fklub.dk, http://fff.fklub.dk, http://fklub.cs.aau.dk, http:// {
	redir /ical/fember.ics https://calendar.google.com/calendar/ical/fke9k8sbuqttoif5ff7ccbb0bc%40group.calendar.google.com/public/basic.ics
	redir /ical/frivillig.ics https://calendar.google.com/calendar/ical/57a0e9bcc00b07d48d08d1aaa8c26f9c8345f96fdf8849f444251f417af9284e%40group.calendar.google.com/public/basic.ics

	@booking path /bookaau /bookaau/* /aaubooking /aaubooking/*
	redir @booking https://forms.office.com/pages/responsepage.aspx?id=Sbrb9QbOb0msPgzxQ2HZNMFGXdYJ2NRJiGVt0NKQxHFUMUNGVVpFQjFTNTBDSkdNVlE4TUdHSksxOSQlQCN0PWcu&route=shorturl

	@adsl path /adsl /adsl/*
	redir @adsl https://www.aauvalg.aau.dk/sadan-stemmer-du#log-ind-i-e-valgsystemet-for-at-stemme

	@fappen2 path /fappen2 /fappen2/*
	redir @fappen2 https://refactor-rework-song-build-s.fappen.pages.dev

	# Moved as they were from Apache. Going by the names, these reach two Stregsystem Pis.
	handle_path /erstregsystemetspinede* {
		reverse_proxy 172.25.11.72:8000
	}
	handle_path /erstregsystemetspiikantinennede* {
		reverse_proxy 172.25.11.74:8000
	}

	handle {
		reverse_proxy 127.0.0.1:8090
	}
	log
}

