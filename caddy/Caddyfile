# The allowlist is outside this repo, because it lists people's homes. See the README.
http://stregsystem.fklub.dk {
	import /etc/caddy/stregsystem-allowlist.caddy

	handle @stregsystem_allowed {
		# Closed rooms go to the main room. To open one for an occasion, remove it from this list.
		@closed_rooms path_regexp ^/(1|2|3|5|6|7|8|9|11|15|16)(/.*)?$
		redir @closed_rooms /10/

		handle_path /static/* {
			root * /data/stregsystem/static
			file_server
		}
		handle_path /media/* {
			root * /data/stregsystem/media
			# Kiosk images change, so browsers must not cache them.
			@images path *.png *.jpg
			header @images Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
			file_server {
				hide .htaccess
			}
		}
		handle {
			reverse_proxy unix//run/stregsystem.sock
		}
	}

	handle {
		import denied
	}
}

# This moves to /srv when Stregsystem moves.
http://api.stregsystem.fklub.dk {
	import static /data/stregsystem/openapi/out
}
