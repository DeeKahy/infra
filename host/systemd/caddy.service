[Unit]
Description=Caddy web server for the small F-klubben sites
Documentation=https://github.com/f-klubben/infra
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /srv/infra/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /srv/infra/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy

[Install]
WantedBy=multi-user.target
